# ─────────────────────────────────────────────────────────────
# Caddyfile — CN360Live Relay Reverse Proxy (ทางเลือก)
#
# ทำไมต้องมี Caddy?
#   หน้าเว็บโหลดจาก Vercel (HTTPS) แต่ relay server ใช้ HTTP
#   Browser จะ block "Mixed Content" ทันที — ดึง .m3u8 หรือ
#   WebRTC signaling จาก HTTP origin ไม่ได้เลย
#   Caddy แก้ปัญหานี้โดย terminate TLS และ proxy ไปหา MediaMTX
#   พร้อมเพิ่ม CORS header ให้ถูกต้อง
#
# วิธีใช้:
#   1. ชี้ DNS ของ YOUR_DOMAIN ไปที่ IP ของ VPS
#   2. uncomment บล็อก caddy ใน docker-compose.yml
#   3. docker compose up -d
#   Caddy จะขอ TLS cert จาก Let's Encrypt อัตโนมัติ
# ─────────────────────────────────────────────────────────────

# แทนที่ stream.yourdomain.com ด้วย domain จริง
stream.yourdomain.com {

  # ── HLS ───────────────────────────────────────────────────
  handle /live/* {
    reverse_proxy mediamtx:8888

    header {
      Access-Control-Allow-Origin  "https://cn360-360vr-live.vercel.app"
      Access-Control-Allow-Methods "GET, OPTIONS"
      Access-Control-Allow-Headers "Range"
      # แก้ origin ให้ตรงกับ URL Vercel จริงของคุณ
    }
  }

  # ── WebRTC signaling ──────────────────────────────────────
  handle /whep/* {
    reverse_proxy mediamtx:8889

    header {
      Access-Control-Allow-Origin  "https://cn360-360vr-live.vercel.app"
      Access-Control-Allow-Methods "GET, POST, OPTIONS"
      Access-Control-Allow-Headers "Content-Type"
    }
  }

  # ── Health check endpoint ─────────────────────────────────
  handle /health {
    reverse_proxy mediamtx:9997
  }

  # TLS อัตโนมัติจาก Let's Encrypt
  tls {
    protocols tls1.2 tls1.3
  }
}
